PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=https://kalkulatorbazis.hu,https://www.kalkulatorbazis.hu,http://localhost:3000

# Optional live market feed. Without a key the engine automatically uses MNB/ECB reference data.
TRADINGVIEW_API_KEY=
TRADINGVIEW_BASE_URL=https://api.tradingviewapi.com
TRADINGVIEW_FX_EXCHANGES=FOREXCOM,FX_IDC
TRADINGVIEW_TIMEOUT_MS=5000
LIVE_RATE_CACHE_MS=60000
LIVE_STALE_MAX_MS=900000

# Official reference fallbacks.
MNB_BASE_URL=https://www.mnb.hu/arfolyamok.asmx
MNB_TIMEOUT_MS=5000
ECB_BASE_URL=https://data-api.ecb.europa.eu/service
ECB_TIMEOUT_MS=5000
REFERENCE_STALE_MAX_MS=172800000

RATE_LIMIT_MAX=120
DOCS_ENABLED=true
TRUST_PROXY=false
